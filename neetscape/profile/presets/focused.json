{
  "version": 2,
  "label": "Focused search (an example role: rewrite the phrases, fields, filters and rules for the person and the country)",
  "candidate": {
    "summary": "Replace with a short summary of the person (written by the agent from the CV).",
    "strengths": [],
    "constraints": []
  },
  "defaults": {
    "max_age_days": 45
  },
  "searches": [
    {
      "id": "main",
      "label": "Main role (example: accountant; replace with the person's role)",
      "where": "remote",
      "what": [
        "accountant",
        "accounting",
        "bookkeeping",
        "accounts payable"
      ],
      "fields": [
        "finance"
      ],
      "title_exclude": [
        "senior|\\bsr\\.?\\b|\\blead\\b|principal|head of|director|manager|controller"
      ],
      "levels_exclude": [
        "senior",
        "lead",
        "manager"
      ]
    }
  ],
  "rank": {
    "rules": [
      {
        "pattern": "junior|\\bjr\\b|entry|associate",
        "weight": 3,
        "label": "junior / entry level"
      },
      {
        "pattern": "excel|\\bsap\\b",
        "weight": 2,
        "field": "any",
        "label": "tools the person knows (example)"
      }
    ],
    "tags": [
      {
        "id": "JR",
        "label": "Junior / entry level",
        "pattern": "junior|\\bjr\\b|entry"
      }
    ],
    "sort": [
      "score",
      "new",
      "pay"
    ]
  },
  "review": {
    "mode": "auto",
    "details_top": 60
  }
}
